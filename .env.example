# Core runtime
KST_TIMEZONE=Asia/Seoul
OUTPUT_ROOT=outputs
LOG_LEVEL=INFO

# News sources
NEWSAPI_KEY=your_newsapi_key
NEWSAPI_QUERY=(economy OR inflation OR interest rates OR central bank OR employment OR market)
NEWS_FETCH_LIMIT=50
RSS_FEEDS=https://feeds.reuters.com/reuters/businessNews,https://www.cnbc.com/id/100003114/device/rss/rss.html

# Summarizer provider: openai | extractive
SUMMARIZER_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# TTS provider: gtts | google_cloud
TTS_PROVIDER=gtts
TTS_LANGUAGE=ko
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# Image provider: pexels | none
IMAGE_PROVIDER=none
PEXELS_API_KEY=

# YouTube upload
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_CATEGORY_ID=25
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_DEFAULT_TAGS=경제뉴스,오늘경제,시장분석
YOUTUBE_CHANNEL_LANGUAGE=ko

# Scheduler
RUN_DAILY=true
RUN_TIME_KST=07:00
